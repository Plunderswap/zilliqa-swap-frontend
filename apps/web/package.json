{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "LC_ALL=\"en_US.UTF-8\" vitest --run",
    "test:watch": "LC_ALL=\"en_US.UTF-8\" vitest --watch",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "lint:style": "npx stylelint '**/*.{ts,tsx}'",
    "format:write": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\"",
    "typechecks": "tsc --noEmit -p ./tsconfig.json"
  },
  "browserslist": {
    "production": [
      "chrome >= 67",
      "edge >= 79",
      "firefox >= 68",
      "opera >= 54",
      "safari >= 14"
    ],
    "development": [
      ">0.2%",
      "not ie <= 99",
      "not android <= 4.4.4",
      "not dead",
      "not op_mini all"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.3.7",
    "@dex/chains": "workspace:*",
    "@dex/hooks": "workspace:*",
    "@dex/localization": "workspace:*",
    "@dex/multicall": "workspace:*",
    "@dex/permit2-sdk": "workspace:*",
    "@dex/sdk": "workspace:*",
    "@dex/smart-router": "workspace:*",
    "@dex/swap-sdk-core": "workspace:*",
    "@dex/token-lists": "workspace:*",
    "@dex/tokens": "workspace:*",
    "@dex/ui-wallets": "workspace:*",
    "@dex/uikit": "workspace:*",
    "@dex/universal-router-sdk": "workspace:*",
    "@dex/utils": "workspace:*",
    "@dex/v3-sdk": "workspace:*",
    "@dex/wagmi": "workspace:*",
    "@dex/widgets-internal": "workspace:*",
    "@reduxjs/toolkit": "2.12.0",
    "@scure/base": "2.2.0",
    "@tanstack/react-query": "^5.18.0",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "@walletconnect/ethereum-provider": "2.23.10",
    "@yornaath/batshit": "^0.14.0",
    "bignumber.js": "^11.1.5",
    "dayjs": "^1.11.10",
    "ethers": "^6.17.0",
    "jotai": "^2.4.3",
    "js-cookie": "^3.0.1",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "next-themes": "0.4.6",
    "react": "^19.2.7",
    "react-device-detect": "^2.1.2",
    "react-dom": "^19.2.7",
    "react-redux": "9.3.0",
    "react-transition-group": "^4.4.5",
    "react-window": "^2.2.7",
    "recharts": "^3.9.2",
    "redux": "5.0.1",
    "redux-persist": "6.0.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "6.4.3",
    "styled-system": "^5.1.5",
    "swiper": "14.0.5",
    "viem": "2.55.1",
    "wagmi": "3.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@cloudflare/workers-types": "5.20260713.1",
    "@dex/tsconfig": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/js-cookie": "^3.0.2",
    "@types/lodash": "^4.14.178",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.1",
    "@types/react-window": "^2.0.0",
    "@types/styled-system": "^5.1.17",
    "@swc/plugin-styled-components": "12.15.0",
    "@vitejs/plugin-react-swc": "4.3.1",
    "eslint": "9.39.5",
    "happy-dom": "20.10.6",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "vite": "8.1.4",
    "vite-tsconfig-paths": "^6.0.2",
    "wrangler": "4.110.0"
  }
}
