{
  "extends": "@dex/tsconfig/base.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true,
    "target": "ES2020",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node", "@cloudflare/workers-types"],
    "paths": {
      "*": ["./src/*"],
      "@dex/uikit": ["../../packages/uikit/src/index.ts"],
      "@dex/uikit/*": ["../../packages/uikit/src/*"]
    }
  },
  "exclude": ["**/node_modules", "**/.*/", "**/config/abi/types/", "**/abis/types/*.ts"],
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "vite.config.ts", "worker-configuration.d.ts"]
}
