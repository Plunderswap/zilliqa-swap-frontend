{
  "name": "@dex/v3-sdk",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "version": "3.8.0",
  "description": "SDK for V3 pools, positions and trades",
  "keywords": [
    "bsc"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest --run",
    "update:snapshot": "vitest -u",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@dex/sdk": "workspace:*",
    "@dex/swap-sdk-core": "workspace:*",
    "@dex/chains": "workspace:*",
    "tiny-invariant": "^1.3.0",
    "viem": "2.55.1"
  },
  "devDependencies": {
    "@dex/utils": "workspace:*"
  },
  "engines": {
    "node": ">=10"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  }
}
