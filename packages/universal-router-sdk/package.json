{
  "name": "@dex/universal-router-sdk",
  "version": "1.0.11",
  "description": "SDK for encoding Universal Router swaps",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "coverage": "vitest run --coverage",
    "test": "vitest --run",
    "clean": "rm -rf node_modules && rm -rf dist",
    "format:check": "prettier --check --loglevel error \"{src,test}/**/*.{js,jsx,ts,tsx,json}\"",
    "format:write": "prettier --write \"{src,test}/**/*.{js,jsx,ts,tsx,json}\"",
    "lint": "eslint '{src,test}/**/*.{js,jsx,ts,json}'"
  },
  "devDependencies": {
    "@dex/tokens": "workspace:*",
    "@types/node": "^26.1.1",
    "tslib": "^2.3.0"
  },
  "dependencies": {
    "@dex/chains": "workspace:*",
    "@dex/permit2-sdk": "workspace:*",
    "@dex/sdk": "workspace:*",
    "@dex/smart-router": "workspace:*",
    "@dex/v3-sdk": "workspace:*",
    "abitype": "^1.2.4",
    "tiny-invariant": "^1.1.0",
    "viem": "2.55.1"
  }
}
