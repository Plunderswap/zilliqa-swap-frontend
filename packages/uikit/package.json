{
  "name": "@dex/uikit",
  "version": "0.65.6",
  "description": "UI components, hooks and theme",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css.ts",
    "src/css/**/*",
    "src/theme/**/*"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    },
    "./css/atoms": {
      "import": "./src/css/atoms.ts",
      "types": "./dist/css/atoms.d.ts"
    },
    "./css/vars.css": {
      "import": "./src/css/vars.css.ts",
      "types": "./dist/css/vars.css.d.ts"
    },
    "./css/responsiveStyle": {
      "import": "./src/css/responsiveStyle.ts",
      "types": "./dist/css/responsiveStyle.d.ts"
    }
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:uikit": "vite build",
    "dev": "vite build --watch --mode development",
    "start": "bun run storybook",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "format:check": "prettier --check --loglevel error 'src/**/*.{js,jsx,ts,tsx}'",
    "format:write": "prettier --write 'src/**/*.{js,jsx,ts,tsx}'",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test": "vitest --run",
    "update:snapshot": "vitest -u",
    "prepublishOnly": "bun run build:uikit",
    "clean": "rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@dex/chains": "workspace:*",
    "@dex/hooks": "workspace:*",
    "@dex/utils": "workspace:*",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/plugin-url": "^8.0.2",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/builder-vite": "^10.5.0",
    "@storybook/react": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.0",
    "@types/js-cookie": "^3.0.2",
    "@types/lodash": "^4.14.168",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.1.7",
    "@types/react-transition-group": "^4.4.1",
    "@types/styled-system__should-forward-prop": "^5.1.2",
    "@vanilla-extract/vite-plugin": "5.2.4",
    "@vitejs/plugin-react": "6.0.3",
    "babel-loader": "^10.1.1",
    "babel-plugin-styled-components": "^2.3.0",
    "d3": "^7.8.2",
    "happy-dom": "20.10.6",
    "jest-styled-components": "^7.0.8",
    "js-cookie": "*",
    "next-themes": "0.4.6",
    "polished": "^4.2.2",
    "react": "^19.2.7",
    "react-countup": "^6.4.0",
    "react-device-detect": "*",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "react-transition-group": "*",
    "remark-gfm": "*",
    "rollup": "^4.62.2",
    "rollup-plugin-node-builtins": "^2.1.2",
    "storybook": "10.5.0",
    "styled-components": "6.4.3",
    "vite": "8.1.4",
    "vite-plugin-dts": "5.0.3",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "peerDependencies": {
    "js-cookie": "*",
    "next-themes": "0.4.6",
    "react": "^19.2.7",
    "react-device-detect": "*",
    "react-dom": "^19.2.7",
    "react-redux": "9.3.0",
    "react-transition-group": "*",
    "remark-gfm": "*",
    "styled-components": "6.4.3"
  },
  "dependencies": {
    "@dex/hooks": "workspace:*",
    "@dex/localization": "workspace:*",
    "@popperjs/core": "^2.9.2",
    "@radix-ui/react-dismissable-layer": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.0",
    "@styled-system/should-forward-prop": "^5.1.5",
    "@types/styled-system": "^5.1.17",
    "@vanilla-extract/css": "1.21.1",
    "bignumber.js": "^11.1.5",
    "clsx": "^2.1.1",
    "csstype": "^3.1.2",
    "dayjs": "^1.11.10",
    "framer-motion": "12.42.2",
    "lodash": "^4.17.20",
    "react-popper": "^2.3.0",
    "sonner": "^2.0.7",
    "styled-system": "^5.1.5",
    "tslib": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
